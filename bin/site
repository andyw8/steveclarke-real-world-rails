#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

ruby site/build.rb

if ! command -v python3 >/dev/null; then
  echo "python3 is required to serve the site" >&2
  exit 1
fi

port="${PORT:-8000}"
echo "Serving http://localhost:${port}/ (Ctrl-C to stop)"
exec python3 -m http.server "$port" --directory site
